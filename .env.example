# Road Guard AI — Environment Variables
# Copy this to .env and fill in your keys
# NEVER commit .env to git

# Roboflow (get from roboflow.com → avatar → API Keys)
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# OpenWeatherMap (get from openweathermap.org → API Keys → free tier)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# MongoDB (Atlas connection string or local)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/roadguard

# Default location for weather (Madurai coordinates)
DEFAULT_LAT=9.9252
DEFAULT_LON=78.1198
